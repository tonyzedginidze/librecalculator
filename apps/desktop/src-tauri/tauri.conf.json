{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Libre Calculator",
  "version": "../package.json",
  "identifier": "com.librecalculator.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Libre Calculator",
        "url": "/",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      },
      {
        "label": "quick",
        "title": "Quick Calculator",
        "url": "/?panel=quick",
        "width": 600,
        "height": 460,
        "minWidth": 600,
        "minHeight": 460,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "maximizable": false,
        "minimizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Libre Calculator",
    "homepage": "https://librecalculator.com",
    "category": "Utility",
    "shortDescription": "Calculators that show their working",
    "longDescription": "Libre Calculator is a free collection of calculators. Every result comes with a worked explanation of how it was reached, and a quick panel opens from anywhere with a keyboard shortcut.",
    "copyright": "Libre Calculator contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "rpm": {
        "release": "1"
      }
    }
  }
}
