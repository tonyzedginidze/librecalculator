{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Libre Calculator",
  "version": "0.1.0",
  "identifier": "com.librecalculator.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Libre Calculator",
        "url": "/",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      },
      {
        "label": "quick",
        "title": "Quick Calculator",
        "url": "/?panel=quick",
        "width": 600,
        "height": 460,
        "minWidth": 600,
        "minHeight": 460,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true,
        "maximizable": false,
        "minimizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
