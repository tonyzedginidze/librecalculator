---
import { creatorUrl } from "@open-calculators/dom-ui/catalog";
import { Sidebar } from "@open-calculators/dom-ui/components";
import { ui } from "@open-calculators/i18n/ui";
import Base from "../layouts/Base.astro";
import { repository } from "../seo";

const paragraphs = ["1", "2", "3"] as const;
---
<Base title={ui["ui.about.title"]} fullTitle={ui["ui.about.title"]} description={ui["ui.about.description"]}>
  <div class="oc-app"><Sidebar client:load /><main class="oc-main oc-letter" id="calculator">
    <h1 class="oc-kicker">{ui["ui.about.title"]}</h1>
    <a class="oc-letter-photo" href={creatorUrl} rel="noopener" aria-label={ui["ui.creator.linkedin"]}>
      <img src="/tony.jpg" width="64" height="64" alt={ui["ui.creator.photoAlt"]} />
    </a>
    {paragraphs.map((key) => <p>{ui[`ui.about.letter.${key}`]}</p>)}
    <p class="oc-letter-signature">{ui["ui.about.signature"]}</p>
    <nav class="oc-letter-links">
      <a href={`${repository}/issues/new`} rel="noopener">{ui["ui.about.contact"]} →</a>
      <a href="/help/">{ui["ui.creator.cta"]} →</a>
    </nav>
  </main></div>
</Base>
