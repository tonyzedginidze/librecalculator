---
import Base from "../layouts/Base.astro";
---

<Base title="Libre Calculator — Orbital Identity Exploration" description="Premium, memorable, and legible orbital brand marks for Libre Calculator.">
  <main class="oc-showcase">
    <header class="oc-showcase-header">
      <div class="oc-showcase-badge">Design Lab · Orbit Edition</div>
      <h1>Orbital Brand Explorations</h1>
      <p class="oc-showcase-lead">
        Exploring orbital and radius geometry where each mark feels substantial, instantly legible, memorable, and authentic to a precision mathematical engine.
      </p>
    </header>

    <div class="oc-concept-grid">

      <!-- Orbit Option 1: The Keplerian Balance (Saturn / Equator Eclipse) -->
      <article class="oc-concept-card">
        <div class="oc-concept-preview">
          <svg viewBox="0 0 48 48" width="60" height="60" fill="none" aria-hidden="true">
            {/* Back rim of ring */}
            <path d="M 9 26 C 8 18 15 11 28 8 C 36 6 41 8 42 11" stroke="var(--oc-accent)" stroke-width="3" stroke-linecap="round" stroke-opacity="0.4"/>
            {/* Bold central planet body */}
            <circle cx="24" cy="24" r="10" fill="var(--oc-accent)"/>
            {/* Sharp equator split beam */}
            <line x1="14" y1="24" x2="34" y2="24" stroke="var(--oc-canvas)" stroke-width="2"/>
            {/* Front prominent sweeping ring */}
            <path d="M 42 11 C 43 15 36 26 21 30 C 13 32 7 30 6 27" stroke="var(--oc-accent)" stroke-width="4.2" stroke-linecap="round"/>
            {/* Poised apex moon */}
            <circle cx="36" cy="13" r="3.2" fill="var(--oc-accent)"/>
          </svg>
        </div>
        <div class="oc-concept-body">
          <span class="oc-concept-tag">Orbit Option 1</span>
          <h2>The Keplerian Eclipse</h2>
          <p class="oc-concept-story">
            <strong>The Concept:</strong> A bold, weighted celestial body with a dramatic tilted ring that sweeps front-to-back with clean depth occlusion. The white equator notch evokes calculation division.
          </p>
          <div class="oc-concept-traits">
            <span>Bold Occlusion</span>
            <span>Iconic</span>
            <span>Astronomical</span>
          </div>
          <div class="oc-sidebar-mock">
            <span class="oc-mock-label">In Sidebar Context:</span>
            <div class="oc-mock-brand">
              <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
                <path d="M 9 26 C 8 18 15 11 28 8 C 36 6 41 8 42 11" stroke="var(--oc-accent)" stroke-width="3" stroke-linecap="round" stroke-opacity="0.4"/>
                <circle cx="24" cy="24" r="10" fill="var(--oc-accent)"/>
                <line x1="14" y1="24" x2="34" y2="24" stroke="var(--oc-canvas)" stroke-width="2"/>
                <path d="M 42 11 C 43 15 36 26 21 30 C 13 32 7 30 6 27" stroke="var(--oc-accent)" stroke-width="4.2" stroke-linecap="round"/>
                <circle cx="36" cy="13" r="3.2" fill="var(--oc-accent)"/>
              </svg>
              <div>
                <div class="oc-mock-title">Libre Calculator</div>
                <div class="oc-mock-sub">The universe in numbers</div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Orbit Option 2: The Quantum Orbital Ratio (Dual Interlocking Ellipses with Core) -->
      <article class="oc-concept-card">
        <div class="oc-concept-preview">
          <svg viewBox="0 0 48 48" width="60" height="60" fill="none" aria-hidden="true">
            {/* Primary orbital ellipse (-30 deg) */}
            <ellipse cx="24" cy="24" rx="20" ry="8" transform="rotate(-30 24 24)" stroke="var(--oc-accent)" stroke-width="3.2" stroke-linecap="round"/>
            {/* Counter orbital ellipse (+30 deg) */}
            <ellipse cx="24" cy="24" rx="20" ry="8" transform="rotate(30 24 24)" stroke="var(--oc-accent)" stroke-width="3.2" stroke-linecap="round"/>
            {/* Solid nucleus core */}
            <circle cx="24" cy="24" r="5.5" fill="var(--oc-accent)"/>
            {/* Upper apex satellite node */}
            <circle cx="40" cy="15" r="3.5" fill="var(--oc-accent)"/>
            {/* Lower counter satellite node */}
            <circle cx="8" cy="33" r="3.5" fill="var(--oc-accent)"/>
          </svg>
        </div>
        <div class="oc-concept-body">
          <span class="oc-concept-tag">Orbit Option 2</span>
          <h2>The Dual Harmonic Orbit</h2>
          <p class="oc-concept-story">
            <strong>The Concept:</strong> Symmetric physics meets computation. Two interlocking elliptical trajectories anchored by a solid core and counterbalanced satellite nodes at golden coordinates.
          </p>
          <div class="oc-concept-traits">
            <span>Symmetrical</span>
            <span>Clean</span>
            <span>Physics & Code</span>
          </div>
          <div class="oc-sidebar-mock">
            <span class="oc-mock-label">In Sidebar Context:</span>
            <div class="oc-mock-brand">
              <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
                <ellipse cx="24" cy="24" rx="20" ry="8" transform="rotate(-30 24 24)" stroke="var(--oc-accent)" stroke-width="3.2" stroke-linecap="round"/>
                <ellipse cx="24" cy="24" rx="20" ry="8" transform="rotate(30 24 24)" stroke="var(--oc-accent)" stroke-width="3.2" stroke-linecap="round"/>
                <circle cx="24" cy="24" r="5.5" fill="var(--oc-accent)"/>
                <circle cx="40" cy="15" r="3.5" fill="var(--oc-accent)"/>
                <circle cx="8" cy="33" r="3.5" fill="var(--oc-accent)"/>
              </svg>
              <div>
                <div class="oc-mock-title">Libre Calculator</div>
                <div class="oc-mock-sub">The universe in numbers</div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Orbit Option 3: The Orbital Ratio Badge (Orbit + Division) -->
      <article class="oc-concept-card">
        <div class="oc-concept-preview">
          <svg viewBox="0 0 48 48" width="60" height="60" fill="none" aria-hidden="true">
            {/* Sweeping 270-degree orbital launch arc */}
            <path d="M 12 36 A 17 17 0 1 1 36 36" stroke="var(--oc-accent)" stroke-width="3.8" stroke-linecap="round"/>
            {/* Horizontal precision chord */}
            <line x1="8" y1="38" x2="40" y2="38" stroke="var(--oc-accent)" stroke-width="3.5" stroke-linecap="round"/>
            {/* Center gravitational body */}
            <circle cx="24" cy="22" r="6" fill="var(--oc-accent)"/>
            {/* Escape velocity orbit satellite */}
            <circle cx="36" cy="36" r="4" fill="var(--oc-accent)"/>
          </svg>
        </div>
        <div class="oc-concept-body">
          <span class="oc-concept-tag">Orbit Option 3</span>
          <h2>The Gravitational Horizon</h2>
          <p class="oc-concept-story">
            <strong>The Concept:</strong> Combines an orbital launch trajectory with an absolute baseline chord. It marries the mathematics of escape velocity with a grounded foundation.
          </p>
          <div class="oc-concept-traits">
            <span>Dynamic</span>
            <span>Architectural</span>
            <span>Distinct</span>
          </div>
          <div class="oc-sidebar-mock">
            <span class="oc-mock-label">In Sidebar Context:</span>
            <div class="oc-mock-brand">
              <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
                <path d="M 12 36 A 17 17 0 1 1 36 36" stroke="var(--oc-accent)" stroke-width="3.8" stroke-linecap="round"/>
                <line x1="8" y1="38" x2="40" y2="38" stroke="var(--oc-accent)" stroke-width="3.5" stroke-linecap="round"/>
                <circle cx="24" cy="22" r="6" fill="var(--oc-accent)"/>
                <circle cx="36" cy="36" r="4" fill="var(--oc-accent)"/>
              </svg>
              <div>
                <div class="oc-mock-title">Libre Calculator</div>
                <div class="oc-mock-sub">The universe in numbers</div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Orbit Option 4: The Aperture Orbit (Triple Overlapping Rings) -->
      <article class="oc-concept-card">
        <div class="oc-concept-preview">
          <svg viewBox="0 0 48 48" width="60" height="60" fill="none" aria-hidden="true">
            {/* Ring 1 (Vertical axis) */}
            <ellipse cx="24" cy="24" rx="8" ry="19" stroke="var(--oc-accent)" stroke-width="2.6"/>
            {/* Ring 2 (-60 deg) */}
            <ellipse cx="24" cy="24" rx="8" ry="19" transform="rotate(-60 24 24)" stroke="var(--oc-accent)" stroke-width="2.6"/>
            {/* Ring 3 (+60 deg) */}
            <ellipse cx="24" cy="24" rx="8" ry="19" transform="rotate(60 24 24)" stroke="var(--oc-accent)" stroke-width="2.6"/>
            {/* Central energy nucleus */}
            <circle cx="24" cy="24" r="5" fill="var(--oc-accent)"/>
          </svg>
        </div>
        <div class="oc-concept-body">
          <span class="oc-concept-tag">Orbit Option 4</span>
          <h2>The Rutherford Gyroscope</h2>
          <p class="oc-concept-story">
            <strong>The Concept:</strong> The classic scientific atomic / gyroscopic model engineered with perfect 60° equilateral angles. Reads instantly as science, energy, and precision calculation.
          </p>
          <div class="oc-concept-traits">
            <span>Atomic</span>
            <span>Mathematical</span>
            <span>Geometric</span>
          </div>
          <div class="oc-sidebar-mock">
            <span class="oc-mock-label">In Sidebar Context:</span>
            <div class="oc-mock-brand">
              <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
                <ellipse cx="24" cy="24" rx="8" ry="19" stroke="var(--oc-accent)" stroke-width="2.8"/>
                <ellipse cx="24" cy="24" rx="8" ry="19" transform="rotate(-60 24 24)" stroke="var(--oc-accent)" stroke-width="2.8"/>
                <ellipse cx="24" cy="24" rx="8" ry="19" transform="rotate(60 24 24)" stroke="var(--oc-accent)" stroke-width="2.8"/>
                <circle cx="24" cy="24" r="5" fill="var(--oc-accent)"/>
              </svg>
              <div>
                <div class="oc-mock-title">Libre Calculator</div>
                <div class="oc-mock-sub">The universe in numbers</div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Orbit Option 5: The Singularity Ratio (Black Hole / Accretion Ring) -->
      <article class="oc-concept-card">
        <div class="oc-concept-preview">
          <svg viewBox="0 0 48 48" width="60" height="60" fill="none" aria-hidden="true">
            {/* Outer event horizon orbit */}
            <circle cx="24" cy="24" r="18" stroke="var(--oc-accent)" stroke-width="2.2" stroke-dasharray="6 3"/>
            {/* Bold tilted accretion disk */}
            <ellipse cx="24" cy="24" rx="19" ry="6.5" transform="rotate(-20 24 24)" stroke="var(--oc-accent)" stroke-width="3.6"/>
            {/* Deep dark gravitational singularity */}
            <circle cx="24" cy="24" r="8" fill="var(--oc-accent)"/>
            {/* Photon ring highlight */}
            <circle cx="24" cy="24" r="3.2" fill="var(--oc-canvas)"/>
          </svg>
        </div>
        <div class="oc-concept-body">
          <span class="oc-concept-tag">Orbit Option 5</span>
          <h2>The Accretion Singularity</h2>
          <p class="oc-concept-story">
            <strong>The Concept:</strong> Theoretical physics rendered into high-contrast vector minimalism. An event horizon dashed orbit encircling an accretion disc and dense core.
          </p>
          <div class="oc-concept-traits">
            <span>Cosmic Depth</span>
            <span>Ultra-Modern</span>
            <span>High Contrast</span>
          </div>
          <div class="oc-sidebar-mock">
            <span class="oc-mock-label">In Sidebar Context:</span>
            <div class="oc-mock-brand">
              <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
                <circle cx="24" cy="24" r="18" stroke="var(--oc-accent)" stroke-width="2" stroke-dasharray="5 3"/>
                <ellipse cx="24" cy="24" rx="19" ry="6.5" transform="rotate(-20 24 24)" stroke="var(--oc-accent)" stroke-width="3.6"/>
                <circle cx="24" cy="24" r="8" fill="var(--oc-accent)"/>
                <circle cx="24" cy="24" r="3.2" fill="var(--oc-canvas)"/>
              </svg>
              <div>
                <div class="oc-mock-title">Libre Calculator</div>
                <div class="oc-mock-sub">The universe in numbers</div>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Orbit Option 6: The Golden Orbital Spiral (Fibonacci Radius) -->
      <article class="oc-concept-card">
        <div class="oc-concept-preview">
          <svg viewBox="0 0 48 48" width="60" height="60" fill="none" aria-hidden="true">
            {/* Inward Fibonacci orbital trajectory */}
            <path d="M 42 24 C 42 33.94 33.94 42 24 42 C 14.06 42 6 33.94 6 24 C 6 15 13 8 22 8 C 29 8 35 13 35 20 C 35 25 31 29 26 29 C 22 29 20 26 20 23" stroke="var(--oc-accent)" stroke-width="3.5" stroke-linecap="round"/>
            {/* Golden ratio focal point */}
            <circle cx="20" cy="23" r="3.5" fill="var(--oc-accent)"/>
            {/* Outer satellite in trajectory */}
            <circle cx="42" cy="24" r="3.2" fill="var(--oc-accent)"/>
          </svg>
        </div>
        <div class="oc-concept-body">
          <span class="oc-concept-tag">Orbit Option 6</span>
          <h2>The Golden Radius Spiral</h2>
          <p class="oc-concept-story">
            <strong>The Concept:</strong> Direct convergence of orbital mechanics and the Golden Ratio ($\Phi$). An expanding logarithmic spiral representing continuous mathematical growth.
          </p>
          <div class="oc-concept-traits">
            <span>Golden Ratio</span>
            <span>Fluid Geometry</span>
            <span>Organic Logic</span>
          </div>
          <div class="oc-sidebar-mock">
            <span class="oc-mock-label">In Sidebar Context:</span>
            <div class="oc-mock-brand">
              <svg viewBox="0 0 48 48" width="30" height="30" fill="none">
                <path d="M 42 24 C 42 33.94 33.94 42 24 42 C 14.06 42 6 33.94 6 24 C 6 15 13 8 22 8 C 29 8 35 13 35 20 C 35 25 31 29 26 29 C 22 29 20 26 20 23" stroke="var(--oc-accent)" stroke-width="3.5" stroke-linecap="round"/>
                <circle cx="20" cy="23" r="3.5" fill="var(--oc-accent)"/>
                <circle cx="42" cy="24" r="3.2" fill="var(--oc-accent)"/>
              </svg>
              <div>
                <div class="oc-mock-title">Libre Calculator</div>
                <div class="oc-mock-sub">The universe in numbers</div>
              </div>
            </div>
          </div>
        </div>
      </article>

    </div>

    <footer class="oc-showcase-footer">
      <a href="/" class="oc-back-home">← Back to Calculators</a>
    </footer>
  </main>
</Base>

<style>
  .oc-showcase {
    max-width: 78rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 5rem;
    font-family: var(--oc-font-sans);
  }

  .oc-showcase-header {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .oc-showcase-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oc-accent);
    background: var(--oc-accent-soft);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .oc-showcase-header h1 {
    font-family: var(--oc-font-serif);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    color: var(--oc-ink);
  }

  .oc-showcase-lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--oc-muted);
    margin: 0;
  }

  .oc-concept-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.75rem;
  }

  .oc-concept-card {
    background: var(--oc-surface);
    border: 1px solid var(--oc-line);
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }

  .oc-concept-card:hover {
    border-color: var(--oc-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .oc-concept-preview {
    background: var(--oc-canvas);
    border: 1px solid var(--oc-line);
    border-radius: 10px;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .oc-concept-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .oc-concept-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oc-muted);
    margin-bottom: 0.25rem;
  }

  .oc-concept-body h2 {
    font-family: var(--oc-font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--oc-ink);
  }

  .oc-concept-story {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--oc-muted);
    margin: 0 0 1rem;
    flex: 1;
  }

  .oc-concept-traits {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .oc-concept-traits span {
    font-size: 0.68rem;
    font-weight: 600;
    background: var(--oc-canvas);
    border: 1px solid var(--oc-line);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    color: var(--oc-muted);
  }

  .oc-sidebar-mock {
    background: var(--oc-canvas);
    border-top: 1px solid var(--oc-line);
    margin: 0 -1.5rem -1.5rem;
    padding: 0.85rem 1.25rem;
    border-radius: 0 0 13px 13px;
  }

  .oc-mock-label {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--oc-muted);
    display: block;
    margin-bottom: 0.4rem;
  }

  .oc-mock-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .oc-mock-title {
    font-family: var(--oc-font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--oc-ink);
  }

  .oc-mock-sub {
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--oc-muted);
  }

  .oc-showcase-footer {
    margin-top: 3.5rem;
    text-align: center;
  }

  .oc-back-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--oc-accent);
    text-decoration: none;
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--oc-accent);
    border-radius: 8px;
    transition: background 120ms ease;
  }

  .oc-back-home:hover {
    background: var(--oc-accent-soft);
  }
</style>
