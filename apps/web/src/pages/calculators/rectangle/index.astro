---
// Generated by scripts/generate-web-topics.ts. Do not edit by hand.
import { calculatorCatalog } from "@open-calculators/calculators";
import { lessonImports } from "@open-calculators/content";
import { calculatorRoute } from "@open-calculators/dom-ui/catalog";
import { LessonArticle, Sidebar } from "@open-calculators/dom-ui/components";
import { presentExample as topicExamplePresenter } from "@open-calculators/dom-ui/topics/rectangle/examples";
import { en } from "@open-calculators/i18n";
import { topicMessageImports } from "@open-calculators/i18n/topics";
import { ui } from "@open-calculators/i18n/ui";
import TopicView from "@open-calculators/dom-ui/topics/rectangle/view";
import Base from "../../../layouts/Base.astro";
import LessonVideo from "../../../components/LessonVideo.astro";

const item = calculatorCatalog.find((candidate) => candidate.id === "rectangle" && candidate.slug === "rectangle");
if (!item) throw new Error("Generated web topic does not match calculator catalog: rectangle/rectangle");
const title = en[item.titleKey] ?? item.id;
const description = en[item.descriptionKey] ?? "";

const loadLesson = lessonImports[item.id as keyof typeof lessonImports];
const loadMessages = topicMessageImports[item.id as keyof typeof topicMessageImports];
const [lessonData, topicMessagesData] = await Promise.all([
  loadLesson?.(),
  loadMessages?.(),
]);

const lesson = lessonData?.lesson;
const messages = {
  ...en,
  ...ui,
  ...(topicMessagesData?.messages ?? {}),
};
---
<Base title={title} description={description}>
  <div class="oc-app">
    <Sidebar client:load activeId={item.id} />
    <main id="calculator" data-category={item.category}>
      <section class="oc-zone oc-zone-tool">
        <div class="oc-zone-inner">
          <TopicView
            client:load
            id={item.id}
            title={title}
            description={description}
            messages={messages}
            locale="en-US"
          />
        </div>
      </section>
      {lesson ? (
        <section class="oc-zone oc-zone-learn">
          <div class="oc-zone-inner">
            <LessonVideo id={item.id} locale="en-US" />
            <LessonArticle
              lesson={lesson}
              messages={messages}
              locale="en-US"
              presenter={topicExamplePresenter}
              relatedHref={(id) => calculatorRoute(id as any)}
            />
          </div>
        </section>
      ) : null}
    </main>
  </div>
</Base>
