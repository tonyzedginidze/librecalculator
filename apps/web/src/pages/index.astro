---
import { CatalogBrowser } from "@open-calculators/dom-ui/components";
import { ui } from "@open-calculators/i18n/ui";
import Base from "../layouts/Base.astro";
---
<Base title={ui["ui.seo.home.title"]} description={ui["ui.seo.home.description"]}>
  <CatalogBrowser
    client:load
    heading={ui["ui.home.heading"]}
    intro={ui["ui.home.intro"]}
  />
</Base>
